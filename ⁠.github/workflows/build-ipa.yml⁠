name: Build Headlock VIP iOS IPA

on:
  push:
    branches: [ "main" ]
  workflow_dispatch:

jobs:
  build:
    runs-on: macos-latest
    steps:
      - name: Checkout Code
        uses: actions/checkout@v4

      - name: Setup Python
        uses: actions/setup-python@v5
        with:
          python-version: '3.10'

      - name: Install Dependencies
        run: |
          pip install --upgrade pip
          pip install buildozer cython

      - name: Compile Project to IPA
        run: |
          buildozer -v ios debug || true

      - name: Upload IPA Artifact
        uses: actions/upload-artifact@v4
        with:
          name: headlock-vip-ipa
          path: bin/*.ipa
